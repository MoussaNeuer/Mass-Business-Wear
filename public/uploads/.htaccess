# Aucune exécution de script dans les uploads
php_flag engine off
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .phar .pht
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .phar .pht
<FilesMatch "\.(?i:php|phtml|php\d|phar|pht|pl|py|cgi|sh|htaccess)$">
  Require all denied
</FilesMatch>

Options -Indexes -ExecCGI
